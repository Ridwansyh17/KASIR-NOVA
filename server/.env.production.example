# KASIR NOVA — Contoh env PRODUKSI (Cloud Run + Cloud SQL)
# JANGAN commit nilai asli. Set lewat Secret Manager / env Cloud Run.

NODE_ENV=production
PORT=4000

# Cloud SQL via unix socket (Cloud Run connector):
#   postgresql://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# JWT secrets (minimal 16 karakter; disarankan >= 64 char acak)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origin frontend (Firebase Hosting). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=https://kasir-nova.web.app

# SEED hanya dijalankan sekali saat setup awal via proxy lokal.
# JANGAN aktifkan di runtime Cloud Run.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
