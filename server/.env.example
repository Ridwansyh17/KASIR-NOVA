# KASIR NOVA — Backend env (CONTOH)
#
# Salin menjadi server/.env. Jangan commit .env!

NODE_ENV=development
PORT=4000

# PostgreSQL dev lokal (port 5433 non-default)
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_KAMU@localhost:5433/nova_kasir_dev

# JWT secret — GANTI di produksi dengan string acak >= 64 char
JWT_ACCESS_SECRET=dev_access_secret_ganti_dengan_acak_64_char
JWT_REFRESH_SECRET=dev_refresh_secret_ganti_dengan_acak_64_char
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seeding dev (npm run db:seed) — jangan pakai nilai ini di produksi
SEED_ADMIN_EMAIL=admin@nova.test
SEED_ADMIN_PASSWORD=ganti_minimal_8_karakter
SEED_ADMIN_NAME=Platform Admin

# Owner demo (opsional) untuk menguji login area Owner
SEED_OWNER_EMAIL=owner@nova.test
SEED_OWNER_PASSWORD=ganti_minimal_8_karakter
SEED_OWNER_NAME=Owner Demo

# ============================================================================
# Payment gateway langganan (uji coba SANDBOX Duitku)
# ============================================================================
# Kosongkan/`disabled` bila tidak dipakai: server tetap berjalan, endpoint
# pembayaran langganan menjawab 503. RAHASIA tidak boleh di-commit.
# PAYMENT_PROVIDER=disabled
# PAYMENT_MODE=sandbox
# PAYMENT_ALLOW_PRODUCTION=false
# DUITKU_MERCHANT_CODE=DXXXX
# DUITKU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kanal aktif (kode Duitku, dipisah koma). Default: VA BCA/BNI/Mandiri/BRI.
# PAYMENT_CHANNELS=BC,I1,M2,BR
# PAYMENT_EXPIRY_MINUTES=1440
# PAYMENT_MIN_AMOUNT_IDR=10000
# URL publik backend (dipakai menyusun callbackUrl/returnUrl bila tidak diisi):
# PAYMENT_API_BASE_URL=https://kasir-nova.vercel.app
# PAYMENT_OWNER_PANEL_URL=https://kasir-nova.web.app/owner
# PAYMENT_CALLBACK_URL=
# PAYMENT_RETURN_URL=
# Daftar IP callback Duitku (opsional; kosong = tidak difilter):
# PAYMENT_CALLBACK_IP_ALLOWLIST=

