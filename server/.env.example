# KASIR NOVA — Backend env (CONTOH)
#
# Salin menjadi server/.env. Jangan commit .env!

NODE_ENV=development
PORT=4000

# PostgreSQL dev lokal (port 5433 non-default)
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_KAMU@localhost:5433/nova_kasir_dev

# JWT secret — GANTI di produksi dengan string acak >= 64 char
JWT_ACCESS_SECRET=dev_access_secret_ganti_dengan_acak_64_char
JWT_REFRESH_SECRET=dev_refresh_secret_ganti_dengan_acak_64_char
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Seeding dev (npm run db:seed) — jangan pakai nilai ini di produksi
SEED_ADMIN_EMAIL=admin@nova.test
SEED_ADMIN_PASSWORD=ganti_minimal_8_karakter
SEED_ADMIN_NAME=Platform Admin

# Owner demo (opsional) untuk menguji login area Owner
SEED_OWNER_EMAIL=owner@nova.test
SEED_OWNER_PASSWORD=ganti_minimal_8_karakter
SEED_OWNER_NAME=Owner Demo

# ============================================================================
# Payment gateway langganan (uji coba SANDBOX Duitku)
# ============================================================================
# Kosongkan/`disabled` bila tidak dipakai: server tetap berjalan, endpoint
# pembayaran langganan menjawab 503. RAHASIA tidak boleh di-commit.
# PAYMENT_PROVIDER=disabled
# PAYMENT_MODE=sandbox
# PAYMENT_ALLOW_PRODUCTION=false
# DUITKU_MERCHANT_CODE=DXXXX
# DUITKU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kanal aktif (kode Duitku, dipisah koma). Default: VA BCA/BNI/Mandiri/BRI.
# PAYMENT_CHANNELS=BC,I1,M2,BR
# PAYMENT_EXPIRY_MINUTES=1440
# PAYMENT_MIN_AMOUNT_IDR=10000
# URL publik backend (dipakai menyusun callbackUrl/returnUrl bila tidak diisi):
# PAYMENT_API_BASE_URL=https://kasir-nova.vercel.app
# PAYMENT_OWNER_PANEL_URL=https://kasir-nova.web.app/owner
# PAYMENT_CALLBACK_URL=
# PAYMENT_RETURN_URL=
# Daftar IP callback Duitku (opsional; kosong = tidak difilter):
# PAYMENT_CALLBACK_IP_ALLOWLIST=

# ============================================================================
# Verifikasi email Owner — Firebase Authentication (23 Okt 2026)
# ============================================================================
# Pendaftaran Owner BARU memakai Firebase Email Verification Link (Spark).
# Login Admin/Kasir dan password Owner tetap memakai auth KASIR NOVA.
#
# Isi SALAH SATU bentuk kredensial server:
#   A) FIREBASE_SERVICE_ACCOUNT_JSON = isi JSON service account (satu baris)
#   B) FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#
# FIREBASE_PRIVATE_KEY boleh memakai newline literal (\n).
# FIREBASE_WEB_API_KEY = Web API Key publik project (dipakai backend untuk
# meminta Firebase mengirim email verifikasi).
# JANGAN commit service account / private key.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_PROJECT_ID=kasir-nova
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kasir-nova.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_WEB_API_KEY=AIzaSy...
# Halaman tujuan tautan Firebase (harus domain resmi/authorized Hosting):
# FIREBASE_VERIFICATION_CONTINUE_URL=https://kasir-nova.web.app/owner/verify-email
# Cooldown kirim ulang per akun (detik, minimal 30):
FIREBASE_RESEND_COOLDOWN_SECONDS=60

# Nomor Admin Platform untuk akun Owner pending LAMA (alur manual WhatsApp).
SUPPORT_WHATSAPP=6281359704766

# Alur email lama (legacy, tidak dipakai pendaftaran baru). Jangan diaktifkan
# bersamaan dengan verifikasi Firebase untuk akun baru.
# MAIL_PROVIDER=resend
# MAIL_FROM=KASIR NOVA <no-reply@domain-terverifikasi.id>
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# APP_PUBLIC_URL=https://kasir-nova.vercel.app
# APP_OWNER_PANEL_URL=https://kasir-nova.web.app/owner
# EMAIL_VERIFICATION_TTL_HOURS=24

