{
  "name": "@nova/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend KASIR NOVA - Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "pretest": "node scripts/clean-test-fixtures.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "admin:list": "node scripts/admin-account.mjs list",
    "admin:create": "node scripts/admin-account.mjs create",
    "admin:password": "node scripts/admin-account.mjs password",
    "admin:status": "node scripts/admin-account.mjs status"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=20"
  }
}
