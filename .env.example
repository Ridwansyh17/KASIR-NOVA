# KASIR NOVA — Variabel Lingkungan (CONTOH)
#
# Salin file ini menjadi `.env` dan isi sesuai lingkungan.
# JANGAN PERNAH commit file `.env` — rahasia harus tetap rahasia.

# --- Backend (server/.env) ---
NODE_ENV=development
PORT=4000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Dev lokal: PostgreSQL 16.1 di port 5433 (non-default), DB nova_kasir_dev
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_KAMU@localhost:5433/nova_kasir_dev

# Secret untuk menandatangani JWT — gunakan string acak minimal 64 char di produksi
JWT_ACCESS_SECRET=dev_access_secret_ganti_dengan_acak_64_char
JWT_REFRESH_SECRET=dev_refresh_secret_ganti_dengan_acak_64_char

# Umur token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — asal frontend yang diizinkan (pisah dengan koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Frontend (apps/*/.env) ---
# URL backend yang dipanggil frontend
VITE_API_URL=http://localhost:4000/api
