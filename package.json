{
  "name": "nova-kasir",
  "version": "0.1.0",
  "private": true,
  "description": "KASIR NOVA - Aplikasi POS multi-outlet (Admin Platform, Owner, Kasir)",
  "workspaces": [
    "server",
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "test:server": "npm run test --workspace server",
    "verify:ui": "node scripts/verify-ui.mjs",
    "test:auth": "node --test scripts/test-auth-restore.mjs",
    "test:image": "node --test scripts/test-product-image.mjs",
    "test:qr": "node --test scripts/test-qr-code.mjs",
    "test:landing": "node scripts/test-landing.mjs",
    "sandbox:duitku": "node scripts/sandbox-duitku-e2e.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "admin:list": "npm run admin:list --workspace server",
    "admin:create": "npm run admin:create --workspace server",
    "admin:password": "npm run admin:password --workspace server",
    "admin:status": "npm run admin:status --workspace server",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restore-db.ps1",
    "db:verify": "node scripts/verify-db.mjs",
    "db:start": "node scripts/pg-local.mjs start",
    "db:stop": "node scripts/pg-local.mjs stop",
    "db:restart": "node scripts/pg-local.mjs restart",
    "db:status": "node scripts/pg-local.mjs status",
    "db:backup:portable": "node scripts/backup-db.mjs",
    "qa:portable": "node scripts/qa-local.mjs",
    "e2e:online": "node scripts/e2e-online.mjs",
    "e2e:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2e-local.ps1",
    "qa:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/qa-local.ps1",
    "theme:apply-v2": "node scripts/apply-theme-v2.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
